{
  "app": {
    "name": "Nokia Snake V2",
    "shortName": "Snake V2",
    "version": "2.0.0",
    "description": "A nostalgic Nokia Snake game with modern gameplay and retro visuals.",
    "developer": "Kiyan Rahmati",
    "repository": "https://github.com/kiyan-rahmati/snake_play_nokia_1",
    "homepage": "https://kiyan-rahmati.github.io/snake_play_nokia_1/",
    "environment": "production"
  },
  "localization": {
    "defaultLanguage": "en",
    "supportedLanguages": [
      "en",
      "fa"
    ],
    "fallbackLanguage": "en",
    "directionByLanguage": {
      "en": "ltr",
      "fa": "rtl"
    }
  },
  "appearance": {
    "defaultTheme": "day",
    "availableThemes": [
      "day",
      "night"
    ],
    "rememberTheme": true,
    "enableThemeTransitions": true
  },
  "navigation": {
    "defaultPage": "home",
    "availablePages": [
      "home",
      "game",
      "profile",
      "settings",
      "achievements"
    ]
  },
  "features": {
    "profiles": true,
    "guestMode": true,
    "localSave": true,
    "highScores": true,
    "achievements": true,
    "multipleWorlds": true,
    "multipleLevels": true,
    "touchControls": true,
    "keyboardControls": true,
    "dayNightThemes": true,
    "soundEffects": true,
    "backgroundMusic": false,
    "cassettePlayer": false,
    "systemInformation": true,
    "offlineSupport": true
  },
  "storage": {
    "keyPrefix": "nokia-snake-v2",
    "saveVersion": 1,
    "useLocalStorage": true,
    "allowSessionFallback": true
  },
  "performance": {
    "targetFramesPerSecond": 60,
    "maxDeltaTimeMs": 100,
    "enableReducedMotionSupport": true
  },
  "privacy": {
    "analyticsEnabled": false,
    "collectPersonalInformation": false,
    "requestPublicIp": false,
    "requireConsentForSystemInformation": true
  },
  "pwa": {
    "enabled": true,
    "manifestPath": "./manifest.webmanifest",
    "serviceWorkerPath": "./service-worker.js",
    "offlinePagePath": "./offline.html"
  },
  "development": {
    "debugMode": false,
    "showPerformanceMetrics": false,
    "logLevel": "warn"
  }
}